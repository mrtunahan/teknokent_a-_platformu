# --- Sunucu ---
NODE_ENV=production
PORT=4000
# Reverse proxy (nginx / load balancer) arkasında gerçek istemci IP'si için hop sayısı
TRUST_PROXY=1
# Virgülle ayrılmış izinli origin listesi (frontend adresleri)
CORS_ORIGINS=https://teknoortak.example.com
# E-posta doğrulama / davet bağlantılarında kullanılacak frontend adresi
APP_URL=https://teknoortak.example.com

# --- Veritabanı ---
MONGODB_URI=mongodb://localhost:27017/teknoortak
# Yalnızca docker compose: MongoDB kök kullanıcısı ve veritabanı adı (varsayılan: teknoortak).
# Ad değişikliğinden (TeknoMatch → TeknoOrtak) önce kurulmuş sunucularda mevcut veriyi kullanmaya devam etmek için:
# MONGO_ROOT_USER=teknomatch
# MONGO_DB=teknomatch

# --- Kimlik doğrulama ---
# Üretimde mutlaka uzun ve rastgele bir değer verin: openssl rand -hex 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
REQUIRE_EMAIL_VERIFICATION=true

# --- E-posta (SMTP) --- boş bırakılırsa e-postalar sadece loglanır
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TeknoOrtak <no-reply@teknoortak.example.com>"

# --- Eşleştirme ---
DAILY_CARD_LIMIT=20
DAILY_RIGHT_SWIPE_LIMIT=20
DAILY_FIRST_MESSAGE_LIMIT=10
CANDIDATE_QUEUE_SIZE=200
LEFT_SWIPE_COOLDOWN_DAYS=90
OUTCOME_PROMPT_DAYS=14
# Opsiyonel Python embedding servisi (POST {texts:[...]} -> {embeddings:[[...]]})
EMBEDDING_SERVICE_URL=

# --- Arka plan işleri ---
ENABLE_JOBS=true
# Gece toplu skor hesaplama (cron, sunucu saat dilimi)
NIGHTLY_RECOMPUTE_CRON=0 3 * * *
OUTCOME_PROMPT_CRON=0 10 * * *
# Embedding servisi için paylaşılan anahtar (docker-compose her iki tarafa da iletir)
EMBEDDING_API_KEY=

# --- Dosya depolama (logo ve belgeler) ---
# local: sunucu diski (UPLOAD_DIR) · s3: AWS S3 / MinIO / Cloudflare R2 / DigitalOcean Spaces
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_LOGO_BYTES=2097152
MAX_DOCUMENT_BYTES=10485760

# --- Web arayüzü ---
# Derlenmiş arayüzü (web/dist) API ile aynı adresten servis et
SERVE_FRONTEND=true
