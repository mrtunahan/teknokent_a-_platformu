{
  "name": "teknomatch-backend",
  "version": "0.1.0",
  "description": "TeknoMatch — Teknokent firma eşleştirme platformu API (Node.js + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "jobs": "node src/jobs/run.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "recompute": "node scripts/recompute.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtunahan/teknokent_a-_platformu.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/mrtunahan/teknokent_a-_platformu/issues"
  },
  "homepage": "https://github.com/mrtunahan/teknokent_a-_platformu#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 20000
  }
}
